#include <windows.h>
#include <commctrl.h>

#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_PAWSE ICON "pawse.ico"
IDI_PAWSE_LOCKED ICON "pawse-locked.ico"

IDD_SETTINGS DIALOGEX 0, 0, 286, 282
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Pawse settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Key bindings", IDC_STATIC, 7, 7, 272, 84
    LTEXT           "Lock or unlock the keyboard:", IDC_STATIC, 16, 22, 120, 8
    CONTROL         "", IDC_BINDING_KEYBOARD, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 140, 20, 130, 13
    LTEXT           "Lock or unlock the mouse:", IDC_STATIC, 16, 40, 120, 8
    CONTROL         "", IDC_BINDING_MOUSE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 140, 38, 130, 13
    LTEXT           "Lock or unlock both:", IDC_STATIC, 16, 58, 120, 8
    CONTROL         "", IDC_BINDING_BOTH, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 140, 56, 130, 13
    LTEXT           "Click a box and press the new keys. Bindings need Ctrl or Alt.", IDC_STATIC, 16, 76, 254, 8

    GROUPBOX        "Unlocking", IDC_STATIC, 7, 96, 272, 76
    AUTOCHECKBOX    "Also require Windows Hello (PIN, fingerprint or face)", IDC_REQUIRE_HELLO, 16, 110, 254, 10, WS_TABSTOP
    LTEXT           "", IDC_HELLO_STATUS, 28, 123, 242, 26
    LTEXT           "Unlock automatically after", IDC_STATIC, 16, 155, 90, 8
    EDITTEXT        IDC_AUTO_UNLOCK, 108, 153, 36, 13, ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_AUTO_UNLOCK_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 144, 153, 10, 13
    LTEXT           "minutes (0 = never)", IDC_STATIC, 150, 155, 120, 8

    GROUPBOX        "General", IDC_STATIC, 7, 177, 272, 74
    AUTOCHECKBOX    "Show a message on lock, on unlock and when a locked device is used", IDC_SHOW_MESSAGE, 16, 191, 254, 10, WS_TABSTOP
    LTEXT           "Hide the message after", IDC_STATIC, 28, 207, 78, 8
    EDITTEXT        IDC_MESSAGE_SECONDS, 108, 205, 36, 13, ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_MESSAGE_SECONDS_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 144, 205, 10, 13
    LTEXT           "seconds", IDC_STATIC, 150, 207, 120, 8
    AUTOCHECKBOX    "Start Pawse when I sign in", IDC_START_WITH_WINDOWS, 16, 223, 254, 10, WS_TABSTOP
    AUTOCHECKBOX    "Check for updates (Pawse asks before installing)", IDC_CHECK_FOR_UPDATES, 16, 237, 254, 10, WS_TABSTOP

    PUSHBUTTON      "Restore defaults", IDC_RESTORE_DEFAULTS, 7, 261, 72, 14
    DEFPUSHBUTTON   "OK", IDOK, 175, 261, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 229, 261, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PAWSE_VERSION_MAJOR, PAWSE_VERSION_MINOR, PAWSE_VERSION_PATCH, 0
 PRODUCTVERSION PAWSE_VERSION_MAJOR, PAWSE_VERSION_MINOR, PAWSE_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Pawse - keyboard and mouse lock"
            VALUE "FileVersion", PAWSE_VERSION_STRING
            VALUE "InternalName", "pawse"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "pawse.exe"
            VALUE "ProductName", "Pawse"
            VALUE "ProductVersion", PAWSE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
